    "@tanstack/react-query": "^5.76.1",
    "zustand": "^5.0.5",
    "lucide-react": "^0.513.0",
    "clsx": "^2.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/express": "^5.0.2",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "tailwindcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.8",
    "express": "^5.1.0",
